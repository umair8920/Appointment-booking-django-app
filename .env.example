# Copy to .env and fill in real values. Never commit .env.

DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (NFR-1) — matches docker-compose defaults when added in Milestone 7
DATABASE_URL=postgres://postgres:postgres@localhost:5432/appointment_booking

# Redis / Celery (Docs/06)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Stripe test mode (Docs/06)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Abandoned checkout hold (FR-13)
PENDING_APPOINTMENT_TIMEOUT_MINUTES=15

# Google OAuth (Docs/05)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cliniko / PMS (Docs/07)
PMS_ADAPTER=integrations.cliniko.adapter.ClinikoAdapter
CLINIKO_API_KEY=
CLINIKO_BASE_URL=https://api.au1.cliniko.com/v1
