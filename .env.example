# Copy to .env and fill in real values. Never commit .env.

DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (NFR-1) — matches docker-compose defaults when added in Milestone 7
DATABASE_URL=postgres://postgres:postgres@localhost:5432/appointment_booking

# Redis / Celery (Docs/06)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Stripe test mode (Docs/06)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Create in Stripe Dashboard → Developers → Webhooks → Add endpoint:
#   URL:  http://<your-host>/api/payments/webhook/stripe/
#   Events: payment_intent.succeeded, payment_intent.payment_failed, charge.refunded
# Then paste the signing secret here:
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Abandoned checkout hold (FR-13)
PENDING_APPOINTMENT_TIMEOUT_MINUTES=15

# Google OAuth (Docs/05 / Docs/10) — allauth redirect flow for the web UI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# In Google Cloud Console → Credentials → OAuth 2.0 Client (Web application):
#   Authorized JavaScript origins:
#     http://localhost:8000
#   Authorized redirect URIs (callback — this is the important one):
#     http://localhost:8000/accounts/google/login/callback/
# Django Site domain must match (we set it to localhost:8000 after migrate).
# Optional override for API SocialLoginView:
# GOOGLE_OAUTH_CALLBACK_URL=http://localhost:8000/accounts/google/login/callback/

# Cliniko / PMS (Docs/07)
PMS_ADAPTER=integrations.cliniko.adapter.ClinikoAdapter
CLINIKO_API_KEY=
# Must match the shard suffix on your API key (e.g. ...-au5 → api.au5.cliniko.com).
# The client also auto-detects shard from the key when present.
CLINIKO_BASE_URL=https://api.au1.cliniko.com/v1
CLINIKO_BUSINESS_ID=
CLINIKO_APPOINTMENT_TYPE_ID=
# Optional (adapter auto-picks first if blank):
CLINIKO_BUSINESS_ID=
CLINIKO_APPOINTMENT_TYPE_ID=
